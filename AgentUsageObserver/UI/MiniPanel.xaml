<Window x:Class="AgentUsageObserver.UI.MiniPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentUsageObserver.Services.Localization"
        Title="Agent Usage"
        Width="330"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="OnDeactivated">
    <Border CornerRadius="10"
            Background="#1E1E24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{loc:Tr AppName}"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <ScrollViewer MaxHeight="520"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProvidersHost"/>
            </ScrollViewer>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="{loc:Tr OpenSettingsLink}"
                           x:Name="OpenSettingsLink"
                           HorizontalAlignment="Right"
                           Foreground="#7AA2F7"
                           FontSize="11"
                           Cursor="Hand"
                           MouseLeftButtonUp="OnOpenSettings"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
