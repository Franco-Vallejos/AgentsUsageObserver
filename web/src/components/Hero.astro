---
import { currentRelease } from "../data/releases";
import { asset } from "../lib/asset";

const logo = asset("logo.png");
---

<section id="top" class="hero">
  <div class="container grid">
    <div class="copy">
      <div class="brand">
        <img src={logo} alt="" width="40" height="40" />
        <span>Agent Usage Observer</span>
      </div>
      <p class="eyebrow">Para Windows · Agentes de IA</p>
      <h1>Mira cuanto te queda de tus agentes, sin abrir nada.</h1>
      <p class="lead">
        Agent Usage Observer vive en la bandeja del sistema y te muestra de un vistazo
        el uso de Claude Code y Codex, con ventanas de 5 horas y semanal,
        refresco por agente y alertas visuales antes de pegar contra el limite.
      </p>
      <div class="actions">
        <a href={currentRelease.installer} class="btn btn-primary" download>
          Descargar para Windows
        </a>
        <a href="#versions" class="btn btn-ghost">Ver versiones</a>
      </div>
      <p class="meta">
        Version {currentRelease.version} · Para Windows 10 y 11
      </p>
    </div>

    <div class="mock" aria-hidden="true">
      <div class="panel">
        <div class="agent-block">
          <div class="panel-head">
            <strong>Codex</strong>
            <span class="dot dot-yellow"></span>
            <button class="refresh" title="Actualizar" aria-label="Actualizar">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path
                  d="M 12 4 A 5 5 0 1 0 13 7.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"></path>
                <path d="M 9.2 3.6 L 12.4 3.8 L 11.6 7 Z" fill="currentColor"></path>
              </svg>
            </button>
          </div>

          <div class="bar-row">
            <div class="bar-label"><span>Ultimas 5h</span><span>68%</span></div>
            <div class="track">
              <i style="width:68%;background:var(--yellow)"></i>
            </div>
            <div class="reset">Reinicia en 1h 24m</div>
          </div>

          <div class="bar-row compact">
            <div class="bar-label"><span>Semana</span><span>19%</span></div>
            <div class="track">
              <i style="width:19%;background:var(--green)"></i>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="agent-block">
          <div class="panel-head">
            <strong>Claude</strong>
            <span class="dot dot-green"></span>
          </div>

          <div class="bar-row">
            <div class="bar-label"><span>Ultimas 5h</span><span>42%</span></div>
            <div class="track">
              <i style="width:42%;background:var(--green)"></i>
            </div>
            <div class="reset">Reinicia en 4h 51m</div>
          </div>

          <div class="bar-row compact">
            <div class="bar-label"><span>Semana</span><span>78%</span></div>
            <div class="track">
              <i style="width:78%;background:var(--yellow)"></i>
            </div>
          </div>
        </div>

        <div class="panel-foot">
          <span class="muted">Actualizado 14:02:31</span>
          <span class="link">Abrir configuracion</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    border-top: none;
    padding-top: 88px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  h1 {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .lead {
    font-size: 18px;
    color: var(--muted);
    margin: 20px 0 28px;
    max-width: 48ch;
  }
  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .meta {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
  }
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }
  .agent-block + .agent-block {
    margin-top: 16px;
  }
  .divider {
    height: 1px;
    background: var(--line);
    margin: 16px 0;
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .panel-head strong {
    font-size: 15px;
  }
  .refresh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .refresh:hover {
    background: #2a2c34;
    color: var(--text);
  }
  .refresh:hover svg {
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-green {
    background: var(--green);
  }
  .dot-yellow {
    background: var(--yellow);
  }
  .muted {
    color: var(--muted);
    font-size: 12px;
  }
  .bar-row {
    margin-bottom: 18px;
  }
  .bar-row.compact {
    margin-bottom: 0;
  }
  .bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 6px;
  }
  .track {
    height: 8px;
    background: #14151a;
    border-radius: 99px;
    overflow: hidden;
  }
  .track i {
    display: block;
    height: 100%;
    border-radius: 99px;
  }
  .reset {
    color: var(--muted);
    font-size: 11px;
    margin-top: 6px;
  }
  .panel-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
  }
  .panel-foot .link {
    color: var(--blue);
    font-size: 12px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
