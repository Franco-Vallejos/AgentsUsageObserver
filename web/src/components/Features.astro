---
const features = [
  {
    color: 'var(--green)',
    title: 'Siempre a la vista',
    text: 'Un icono en la bandeja del sistema con el porcentaje mas importante al frente. Doble clic abre el panel completo.',
  },
  {
    color: 'var(--yellow)',
    title: 'Aviso por color',
    text: 'Verde, amarillo y rojo segun cuanto consumiste. Te enteras antes de chocar con el limite.',
  },
  {
    color: 'var(--blue)',
    title: 'Dos ventanas de limite',
    text: 'Segui el limite de 5 horas y el semanal por separado, con cuenta regresiva hasta el reinicio.',
  },
  {
    color: 'var(--red)',
    title: 'Claude + Codex',
    text: 'Muestra el uso de Claude Code y Codex en el mismo panel, sin que un provider tape al otro.',
  },
  {
    color: 'var(--blue)',
    title: 'Refresco por agente',
    text: 'Un boton junto al nombre de cada agente actualiza solo su informacion, cuando lo necesitas.',
  },
  {
    color: 'var(--green)',
    title: 'A tu manera',
    text: 'Define tus propios umbrales de color o deja que decida la severidad que reporta el proveedor.',
  },
  {
    color: 'var(--yellow)',
    title: 'A tu ritmo',
    text: 'Ajusta cada cuanto se actualiza la informacion para que consulte solo lo necesario.',
  },
  {
    color: 'var(--blue)',
    title: 'Arranca con Windows',
    text: 'Opcional: que se inicie solo al encender la PC y quede monitoreando en segundo plano.',
  },
];
---

<section id="features">
  <div class="container">
    <p class="eyebrow">Que hace</p>
    <h2>Lo justo para no pasarte de la cuota.</h2>

    <div class="grid">
      {features.map((f) => (
        <div class="card feature">
          <span class="tag" style={`background:${f.color}`}></span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .feature h3 {
    font-size: 18px;
    margin: 14px 0 8px;
  }
  .feature p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }
  .tag {
    display: block;
    width: 32px;
    height: 6px;
    border-radius: 99px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
